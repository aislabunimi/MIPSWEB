<div class="section">
  <button class="button" onclick="backupOptions(); showFormOnClick('settings',undefined,false,() => {restoreOptions();}); setTimeout(getOptionFlagsOnClick,100);">
    <div class="icon gray-4"><%-Icons.render('settings')%></div>
  </button>
</div>
<div class="section project">
  <span class="project">Project: </span><span class="name" ondblclick="enableProjectNameEdit(this)"><%=ctx.projectName%></span>
  <button class="button" onclick="showMenuOnClick(this, '/app/popovers/project-menu-popover.ejs')">
    <div class="icon gray-4"><%-Icons.render('verticalDots')%></div>
  </button>
</div>
<div class="section">
  <button class="button" onclick="showFormOnClick('help',undefined,false)" title="Help (F1)">
    <div class="icon gray-4">?</div>
  </button>
</div>
<%if (ctx.appConfig && ctx.appConfig.mode === "evaluator") {%>
<div class="section">
  <button class="button default evaluator-button" onclick="openEvaluatorOnClick()" title="Evaluate the exams of a folder of students">
    <div class="icon gray-4"><%-Icons.render('microchip')%></div>
    <div class="label">Evaluate exams</div>
  </button>
</div>
<%}%>
